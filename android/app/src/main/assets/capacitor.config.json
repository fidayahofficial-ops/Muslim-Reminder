{
	"appId": "com.waqto.islamicapp",
	"appName": "ওয়াক্ত — WAQTO",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#064e3b"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#064e3b",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		}
	}
}
